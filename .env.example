# Local Development Environment (.env.local)
# Never commit real secrets or production API keys to Git

ENVIRONMENT="development"
APP_URL="http://localhost:3000"

# Cloudflare D1 Local Simulation
CLOUDFLARE_D1_DATABASE_NAME="projukti_labs_db"

# Cloudflare R2 Object Storage (Mock/Local or Development Bucket)
R2_ACCOUNT_ID="local-simulated-account"
R2_ACCESS_KEY_ID="local-simulated-access-key"
R2_SECRET_ACCESS_KEY="local-simulated-secret-key"
R2_BUCKET_NAME="projukti-labs-assets"

# Session & Security Secrets
AUTH_SECRET="dev_secret_must_be_at_least_32_characters_long_for_security"

# Cloudflare Turnstile (Cloudflare Official Dummy Keys for Testing)
# Sitekey: 1x00000000000000000000AA (always passes)
# Secret: 1x0000000000000000000000000000000AA (always passes)
TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

