{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "projukti-labs-web",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "projukti-labs-production",
      "database_id": "8b1097c3-c930-477f-b8bc-81a498ac0f41",
      "migrations_dir": "db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "projukti-labs-assets"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "VINEXT_KV_CACHE",
      "id": "4c3a552b441e491c8d781f198bbb4316"
    },
    {
      "binding": "KV_CACHE",
      "id": "4c3a552b441e491c8d781f198bbb4316"
    }
  ],
  "routes": [
    {
      "pattern": "projuktilabs.tech",
      "custom_domain": true
    },
    {
      "pattern": "www.projuktilabs.tech",
      "custom_domain": true
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "APP_URL": "https://projuktilabs.tech"
  },
  "env": {
    "preview": {
      "vars": {
        "ENVIRONMENT": "preview",
        "APP_URL": "https://preview.projuktilabs.tech"
      }
    },
    "production": {
      "vars": {
        "ENVIRONMENT": "production",
        "APP_URL": "https://projuktilabs.tech"
      }
    }
  }
}
